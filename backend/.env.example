# MongoDB Atlas connection string (never commit the real one)
MONGODB_URI=your_mongodb_atlas_connection_string
DATABASE_NAME=neerus
COLLECTION_NAME=inventory
SUPPLIERS_COLLECTION=suppliers
# Total units (all stores) at or below this count as low stock
LOW_STOCK_THRESHOLD=10
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Secret required in the X-API-Key header for create/update/delete
API_KEY=change_me
